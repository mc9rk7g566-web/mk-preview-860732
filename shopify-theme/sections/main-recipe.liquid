{% comment %}
  Recept-detailpagina (eigen indexeerbare URL, goed voor Google). Zelfde premium
  opzet als het uitgelichte recept op de home: gecentreerde titel + meta, kookvideo
  met foto's, ingrediënten/bereiding in twee kolommen, wijntip en 'over Maarten'.
  Foto's/video vallen terug op de stills uit de kookvideo; per recept aanpasbaar
  via Customize. Recipe- + VideoObject-structured-data staat onderaan.
{% endcomment %}
{% liquid
  assign ld_ings = section.blocks | where: 'type', 'ingredient'
  assign ld_steps = section.blocks | where: 'type', 'step'
  assign ld_faqs = section.blocks | where: 'type', 'faq'
  assign recipes_url = pages['recepten'].url | default: '/pages/recepten'
  assign over_url = pages['over-maarten'].url | default: '/#over'
  assign alt_step = section.settings.title | append: ' in de keuken van Maarten'
  assign alt_ing = 'De ingrediënten voor ' | append: section.settings.title
  assign alt_wine = 'De wijn die Maarten schenkt bij ' | append: section.settings.title
  if settings.community_url != blank
    assign wine_url = pages['join'].url | default: settings.community_url
    assign wine_label = 'Join The Cellar Club'
    assign wine_blank = true
  else
    assign wine_url = routes.root_url | append: '#recept'
    assign wine_label = 'Bekijk het recept'
    assign wine_blank = false
  endif
%}
<article class="recipe-feature recipe-detail">
  <section class="recipe-hero">
    <div class="wrap">
      <a class="back" href="{{ recipes_url }}"><i class="ph ph-arrow-left" aria-hidden="true"></i>Alle recepten</a>
      <p class="meta recipe-kicker reveal">{{ section.settings.kicker }}</p>
      <h1 class="display recipe-title reveal">{{ section.settings.title }}</h1>
      <p class="lead recipe-intro reveal">{{ section.settings.intro }}</p>
      <p class="meta recipe-meta reveal"><span><i class="ph ph-clock" aria-hidden="true"></i>{{ section.settings.time }}</span><span><i class="ph ph-users" aria-hidden="true"></i>{{ section.settings.servings }}</span><span><i class="ph ph-fork-knife" aria-hidden="true"></i>{{ section.settings.course }}</span>{%- comment -%}Zichtbare auteursvermelding met link naar zijn eigen pagina: Google en AI-assistenten wegen mee wie een recept geschreven heeft en of die persoon er verstand van heeft.{%- endcomment -%}<span><i class="ph ph-chef-hat" aria-hidden="true"></i>door <a href="{{ over_url }}">Maarten Kievit</a></span></p>

      <div class="recipe-showcase reveal">
        <figure class="showcase-card showcase-card--video">
          {% if section.settings.show_video %}
            <video src="{{ section.settings.video_file | asset_url }}" poster="{{ section.settings.poster_file | asset_url }}" controls playsinline preload="metadata" width="464" height="832" aria-label="Kookvideo: {{ section.settings.title | escape }}"></video>
            {% if section.settings.video_note != blank %}<figcaption class="video-note"><i class="ph ph-video-camera" aria-hidden="true"></i>{{ section.settings.video_note }}</figcaption>{% endif %}
          {% else %}
            {% render 'responsive-image', image: section.settings.hero_image, fallback: section.settings.img_hero, alt: section.settings.title, sizes: '(max-width: 767px) 80vw, 33vw', loading: 'lazy' %}
          {% endif %}
        </figure>
        <figure class="showcase-card">
          {% render 'responsive-image', image: section.settings.photo_1, fallback: section.settings.img_2, alt: section.settings.title, sizes: '(max-width: 767px) 80vw, 33vw', loading: 'lazy' %}
        </figure>
        <figure class="showcase-card">
          {% render 'responsive-image', image: section.settings.photo_2, fallback: section.settings.img_3, alt: alt_step, sizes: '(max-width: 767px) 80vw, 33vw', loading: 'lazy' %}
        </figure>
      </div>
    </div>
  </section>

  <section class="wrap recipe-body">
    <aside class="ingredients reveal">
      <h2>Ingrediënten</h2>
      <ul>
        {% for block in section.blocks %}
          {%- if block.type == 'group' -%}<li class="ing-group" {{ block.shopify_attributes }}>{{ block.settings.title }}</li>
          {%- elsif block.type == 'ingredient' -%}<li {{ block.shopify_attributes }}><strong>{{ block.settings.name }}</strong><span>{{ block.settings.amount }}</span></li>{%- endif -%}
        {% endfor %}
      </ul>
      <figure class="ingredients-photo">
        {% render 'responsive-image', image: section.settings.photo_ingredients, fallback: section.settings.img_ingredients, alt: alt_ing, sizes: '(max-width: 860px) 100vw, 33vw', loading: 'lazy' %}
      </figure>
    </aside>
    <div class="method reveal">
      <h2>Bereiding</h2>
      <ol>
        {% for block in ld_steps %}<li id="stap-{{ forloop.index }}" {{ block.shopify_attributes }}><p>{{ block.settings.text }}</p></li>{% endfor %}
      </ol>
      {% if section.settings.tip_text != blank %}
      <div class="tip-card method-tip">
        <i class="ph ph-lightbulb" aria-hidden="true"></i>
        <h3>{{ section.settings.tip_title }}</h3>
        <p>{{ section.settings.tip_text }}</p>
      </div>
      {% endif %}
    </div>
  </section>

  <section class="wrap recipe-wine-section">
    <div class="wine-tip reveal">
      <div class="wt-media">
        {% render 'responsive-image', image: section.settings.wine_image, fallback: section.settings.img_wine, alt: alt_wine, sizes: '(max-width: 767px) 100vw, 42vw', loading: 'lazy' %}
      </div>
      <div class="wt-body">
        <span class="wt-label">De wijntip van Maarten</span>
        <h2>{{ section.settings.wine_title }}</h2>
        <p>{{ section.settings.wine_text }}</p>
        <a class="btn btn-light" href="{{ wine_url }}"{% if wine_blank %} target="_blank" rel="noopener"{% endif %}>{{ wine_label }}</a>
      </div>
    </div>
  </section>

  {% if ld_faqs.size > 0 %}
  <section class="wrap recipe-faq">
    <h2 class="display recipe-faq-title">Veelgestelde vragen</h2>
    <div class="cellar-faq">
      {% for block in ld_faqs %}
      <details {{ block.shopify_attributes }}>
        <summary>{{ block.settings.q }}<i class="ph ph-plus" aria-hidden="true"></i></summary>
        <div class="faq-a"><p>{{ block.settings.a }}</p></div>
      </details>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <section class="section section-band">
    <div class="wrap recipe-cta reveal">
      <h2 class="display">Meer recepten van Maarten</h2>
      <p class="lead">Elk nieuw gerecht met de wijn die erbij past. Bekijk alle recepten of laat je mailadres achter voor het volgende.</p>
      <div class="recipe-cta-row">
        <a class="btn btn-primary" href="{{ recipes_url }}">Alle recepten<i class="ph ph-arrow-right" aria-hidden="true"></i></a>
        <a class="btn btn-glass" href="{{ routes.root_url }}#landing-signup">Houd me op de hoogte</a>
      </div>
    </div>
  </section>
</article>

{% liquid
  assign step_images = section.settings.img_3 | append: '|' | append: section.settings.img_ingredients | append: '|' | append: section.settings.img_2 | split: '|'
  assign keywords = section.settings.course | append: ', ' | append: section.settings.cuisine | append: ', ' | append: section.settings.title | downcase
%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": {{ section.settings.title | json }},
  "description": {{ section.settings.intro | json }},
  "image": [{{ section.settings.img_hero | asset_url | prepend: 'https:' | json }}],
  "author": { "@type": "Person", "@id": {{ shop.url | append: '/#maarten' | json }}, "name": "Maarten Kievit", "url": {{ shop.url | append: '/' | json }} },
  {%- if section.settings.date_published != blank %}
  "datePublished": {{ section.settings.date_published | json }},
  {%- endif %}
  "recipeYield": {{ section.settings.servings | json }},
  "recipeCuisine": {{ section.settings.cuisine | json }},
  "recipeCategory": {{ section.settings.course | json }},
  "keywords": {{ keywords | json }},
  "inLanguage": "nl-NL",
  "mainEntityOfPage": { "@type": "WebPage", "@id": {{ canonical_url | json }} },
  "totalTime": {{ section.settings.total_time | json }},
  {%- if section.settings.prep_time != blank %}
  "prepTime": {{ section.settings.prep_time | json }},
  {%- endif %}
  {%- if section.settings.cook_time != blank %}
  "cookTime": {{ section.settings.cook_time | json }},
  {%- endif %}
  {%- if section.settings.date_modified != blank %}
  "dateModified": {{ section.settings.date_modified | json }},
  {%- endif %}
  {%- if section.settings.calories != blank %}
  "nutrition": {
    "@type": "NutritionInformation",
    "servingSize": {{ section.settings.serving_size | default: section.settings.servings | json }},
    "calories": {{ section.settings.calories | append: ' kcal' | json }}
  },
  {%- endif %}
  "recipeIngredient": [
    {% for block in ld_ings %}{{ block.settings.amount | append: ' ' | append: block.settings.name | json }}{% unless forloop.last %},{% endunless %}{% endfor %}
  ],
  "recipeInstructions": [
    {% for block in ld_steps %}{%- assign pic_index = forloop.index0 | modulo: 3 -%}{
      "@type": "HowToStep",
      "name": {{ block.settings.text | split: '.' | first | truncate: 60 | json }},
      "url": {{ canonical_url | append: '#stap-' | append: forloop.index | json }},
      "image": {{ step_images[pic_index] | default: section.settings.img_hero | asset_url | prepend: 'https:' | json }},
      "text": {{ block.settings.text | json }}
    }{% unless forloop.last %},{% endunless %}{% endfor %}
  ]{% comment %}uploadDate is verplicht voor VideoObject: zonder publicatiedatum liever geen video-schema dan een ongeldige datum{% endcomment %}{% if section.settings.show_video and section.settings.date_published != blank %},
  "video": {
    "@type": "VideoObject",
    "name": {{ section.settings.title | prepend: 'Kookvideo: ' | json }},
    "description": {{ section.settings.intro | json }},
    "thumbnailUrl": {{ section.settings.poster_file | asset_url | prepend: 'https:' | json }},
    "contentUrl": {{ section.settings.video_file | asset_url | prepend: 'https:' | json }},
    {%- if section.settings.video_duration != blank %}
    "duration": {{ section.settings.video_duration | json }},
    {%- endif %}
    "uploadDate": {{ section.settings.date_published | append: 'T10:00:00+02:00' | json }}
  }{% endif %}
}
</script>
{% if ld_faqs.size > 0 %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for block in ld_faqs %}{
      "@type": "Question",
      "name": {{ block.settings.q | json }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.a | json }} }
    }{% unless forloop.last %},{% endunless %}{% endfor %}
  ]
}
</script>
{% endif %}

{% schema %}
{
  "name": "Recept",
  "settings": [
    { "type": "header", "content": "Kop" },
    { "type": "text", "id": "kicker", "label": "Kleine tekst boven de titel", "default": "Recept van de week" },
    { "type": "text", "id": "title", "label": "Naam van het gerecht", "default": "Romige tom yum met kokkels" },
    { "type": "textarea", "id": "intro", "label": "Introductie", "default": "Een romige Thaise tom yum met verse kokkels. Fris van limoen en koriander, klaar in 30 minuten." },
    { "type": "text", "id": "time", "label": "Bereidingstijd", "default": "30 min" },
    { "type": "text", "id": "servings", "label": "Aantal personen", "default": "4 personen" },
    { "type": "text", "id": "course", "label": "Soort gerecht", "default": "Vis" },
    { "type": "header", "content": "Video en foto's" },
    { "type": "checkbox", "id": "show_video", "label": "Kookvideo tonen", "default": true },
    { "type": "text", "id": "video_note", "label": "Bijschrift bij de video", "default": "Kijk mee hoe Maarten hem maakt" },
    { "type": "image_picker", "id": "hero_image", "label": "Hoofdfoto (als video uit staat)" },
    { "type": "image_picker", "id": "photo_1", "label": "Foto 2" },
    { "type": "image_picker", "id": "photo_2", "label": "Foto 3" },
    { "type": "image_picker", "id": "photo_ingredients", "label": "Foto bij de ingrediënten" },
    { "type": "header", "content": "Standaardbestanden per recept", "info": "De video en foto's die in het thema zijn opgeslagen. Alleen aanpassen als er nieuwe bestanden zijn geupload; zet je hierboven een eigen foto neer, dan wint die." },
    { "type": "text", "id": "video_file", "label": "Videobestand", "default": "recept-tomyum-video.mp4" },
    { "type": "text", "id": "poster_file", "label": "Videostill (poster)", "default": "recept-tomyum-poster.jpg" },
    { "type": "text", "id": "img_hero", "label": "Hoofdfoto", "default": "recept-tomyum-bord.jpg" },
    { "type": "text", "id": "img_2", "label": "Foto 2", "default": "recept-tomyum-saus.jpg" },
    { "type": "text", "id": "img_3", "label": "Foto 3", "default": "recept-tomyum-pan.jpg" },
    { "type": "text", "id": "img_ingredients", "label": "Foto bij de ingrediënten", "default": "recept-tomyum-mise.jpg" },
    { "type": "text", "id": "img_wine", "label": "Foto bij de wijntip", "default": "recept-tomyum-wijn.jpg" },
    { "type": "header", "content": "Tip van Maarten" },
    { "type": "text", "id": "tip_title", "label": "Titel", "default": "Tip van Maarten" },
    { "type": "textarea", "id": "tip_text", "label": "Tekst", "default": "Het kookvocht van de kokkels is de geheime smaakmaker van dit gerecht. Voeg het beetje bij beetje toe en proef steeds tussendoor; zo blijft de soep perfect in balans." },
    { "type": "header", "content": "Wijntip" },
    { "type": "image_picker", "id": "wine_image", "label": "Foto" },
    { "type": "text", "id": "wine_title", "label": "Titel", "default": "De wijn die erbij past" },
    { "type": "textarea", "id": "wine_text", "label": "Tekst", "default": "In de video schenkt Maarten er een droge witte wijn bij. Zulke mooie flessen koop je in The Cellar Club, zijn besloten wijnclub." },
    { "type": "header", "content": "Google (structured data)" },
    { "type": "text", "id": "cuisine", "label": "Keuken", "default": "Thais" },
    { "type": "text", "id": "total_time", "label": "Totale tijd (ISO)", "info": "Bijvoorbeeld PT30M voor 30 minuten.", "default": "PT30M" },
    { "type": "text", "id": "prep_time", "label": "Voorbereidingstijd (ISO)", "info": "Snijden, kloppen, mise en place. Bijvoorbeeld PT10M. Samen met de kooktijd moet dit optellen tot de totale tijd." },
    { "type": "text", "id": "cook_time", "label": "Kooktijd (ISO)", "info": "De tijd op het vuur of in de oven. Bijvoorbeeld PT20M." },
    { "type": "text", "id": "date_published", "label": "Publicatiedatum", "info": "Formaat JJJJ-MM-DD. Zonder datum laat het thema de kookvideo uit de structured data (Google eist een uploaddatum).", "default": "2026-07-20" },
    { "type": "text", "id": "date_modified", "label": "Laatst bijgewerkt", "info": "Formaat JJJJ-MM-DD. Vul dit in als je het recept later aanpast; Google en AI-assistenten geven voorrang aan verse pagina's." },
    { "type": "text", "id": "video_duration", "label": "Videolengte (ISO)", "info": "Bijvoorbeeld PT1M30S voor anderhalve minuut." },
    { "type": "header", "content": "Voedingswaarde", "info": "Optioneel, maar Google vraagt er expliciet om bij recepten. Alleen invullen als het klopt; laat leeg als je het niet weet." },
    { "type": "text", "id": "calories", "label": "Calorieën per portie", "info": "Alleen het getal, bijvoorbeeld 420." },
    { "type": "text", "id": "serving_size", "label": "Portiegrootte", "info": "Waar de calorieën op slaan, bijvoorbeeld '1 portie' of '1 bord'." }
  ],
  "blocks": [
    { "type": "group", "name": "Tussenkop ingrediënten", "settings": [{ "type": "text", "id": "title", "label": "Tussenkop", "default": "Voor de saus" }] },
    { "type": "ingredient", "name": "Ingrediënt", "settings": [{ "type": "text", "id": "name", "label": "Naam" }, { "type": "text", "id": "amount", "label": "Hoeveelheid" }] },
    { "type": "step", "name": "Bereidingsstap", "settings": [{ "type": "textarea", "id": "text", "label": "Uitleg" }] },
    { "type": "faq", "name": "Vraag", "settings": [{ "type": "text", "id": "q", "label": "Vraag" }, { "type": "textarea", "id": "a", "label": "Antwoord" }] }
  ],
  "max_blocks": 40,
  "presets": [{ "name": "Recept" }]
}
{% endschema %}
