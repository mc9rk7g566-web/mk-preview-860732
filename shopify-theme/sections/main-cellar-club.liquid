{% comment %}
  Aparte landingspagina voor The Cellar Club (conversie: zoveel mogelijk joins).
  Volledige uitleg: wat het is, wat je krijgt, hoe het werkt, FAQ, sterke CTA.
  Link = community_url in Thema-instellingen. Alle teksten via Customize.
{% endcomment %}
{% assign community_url = pages['join'].url | default: settings.community_url | default: '#' %}
<article class="recipe-feature cellar">
  <section class="cellar-hero">
    <div class="cellar-glow" aria-hidden="true"></div>
    {% comment %} Zwevende echte prestige-flessen: Pétrus 1973 (Jamain, CC BY-SA 3.0),
      Bâtard-Montrachet Faiveley (Craig Drollett, CC BY-SA 2.0), Dom Pérignon 1999 (publiek domein);
      via Wikimedia Commons, credits staan onderaan de pagina. Wrapper = positie +
      GSAP-parallax; de img erin = CSS-float. Zo vechten de transforms niet met elkaar. {% endcomment %}
    <span class="cellar-bottle cellar-bottle--bourgogne" data-parallax="60" aria-hidden="true"><img src="{{ 'cellar-fles-bourgogne.webp' | asset_url }}" alt="" width="318" height="1100" loading="eager"></span>
    <span class="cellar-bottle cellar-bottle--bordeaux" data-parallax="-50" aria-hidden="true"><img src="{{ 'cellar-fles-bordeaux.webp' | asset_url }}" alt="" width="292" height="1100" loading="eager"></span>
    <span class="cellar-bottle cellar-bottle--champagne" data-parallax="-90" aria-hidden="true"><img src="{{ 'cellar-fles-champagne.webp' | asset_url }}" alt="" width="386" height="1100" loading="eager"></span>
    <div class="wrap cellar-hero-inner">
      <p class="meta cellar-kicker reveal">{{ section.settings.kicker }}</p>
      <h1 class="display cellar-title reveal">{{ section.settings.title }}</h1>
      <p class="lead cellar-intro reveal">{{ section.settings.intro }}</p>
      {% if community_url != '#' %}
      <div class="feature-cta reveal">
        <a class="btn btn-primary" href="{{ community_url }}" target="_blank" rel="noopener"><i class="ph ph-whatsapp-logo" aria-hidden="true"></i>{{ section.settings.cta_label }}</a>
      </div>
      <p class="meta cellar-reassure reveal">{{ section.settings.reassure }}</p>
      {% endif %}
    </div>
  </section>

  <section class="section cellar-photo">
    <div class="wrap">
      <div class="cellar-hero-media reveal">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 2000 | image_tag: widths: '800, 1200, 1600, 2000', sizes: 'calc(100vw - 48px)', loading: 'lazy', alt: 'Wijnkelder met exclusieve flessen' }}
        {% else %}
          <img src="{{ 'community.jpg' | asset_url }}" width="2000" height="1333" alt="Wijnkelder met exclusieve flessen" loading="lazy">
        {% endif %}
      </div>
    </div>
  </section>

  <section class="section section-band">
    <div class="wrap">
      <div class="band-head reveal"><h2 class="display">{{ section.settings.benefits_title }}</h2></div>
      <div class="coming-grid">
        {% for block in section.blocks %}{% if block.type == 'benefit' %}
        <div class="coming-item reveal" {{ block.shopify_attributes }}>
          <i class="ph {{ block.settings.icon | default: 'ph-wine' }}" aria-hidden="true"></i>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
        {% endif %}{% endfor %}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap cellar-steps-wrap">
      <div class="band-head reveal"><h2 class="display">{{ section.settings.steps_title }}</h2></div>
      <ol class="cellar-steps reveal">
        {% if section.settings.step1 != blank %}<li><span>{{ section.settings.step1 }}</span></li>{% endif %}
        {% if section.settings.step2 != blank %}<li><span>{{ section.settings.step2 }}</span></li>{% endif %}
        {% if section.settings.step3 != blank %}<li><span>{{ section.settings.step3 }}</span></li>{% endif %}
      </ol>
    </div>
  </section>

  {% assign faqs = section.blocks | where: 'type', 'faq' %}
  {% if faqs.size > 0 %}
  <section class="section section-band">
    <div class="wrap cellar-faq-wrap">
      <div class="band-head reveal"><h2 class="display">{{ section.settings.faq_title }}</h2></div>
      <div class="cellar-faq reveal">
        {% for block in faqs %}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.q }}<i class="ph ph-plus" aria-hidden="true"></i></summary>
          <p>{{ block.settings.a }}</p>
        </details>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  <section class="section community">
    <div class="wrap">
      <div class="community-card cellar-final reveal">
        <div class="community-body cellar-final-body">
          <h2 class="display">{{ section.settings.final_title }}</h2>
          <p>{{ section.settings.final_text }}</p>
          {% if community_url != '#' %}
          <div class="community-cta-row">
            <a class="btn btn-light community-cta" href="{{ community_url }}" target="_blank" rel="noopener"><i class="ph ph-whatsapp-logo" aria-hidden="true"></i>{{ section.settings.cta_label }}</a>
          </div>
          {% if section.settings.reassure != blank %}<p class="community-note">{{ section.settings.reassure }}</p>{% endif %}
          {% endif %}
        </div>
      </div>
      {% comment %} Verplichte naamsvermelding CC BY-SA-flesfoto's {% endcomment %}
      <p class="meta cellar-credits">Flesfoto's: Jamain &middot; Craig Drollett (CC BY-SA) &middot; via Wikimedia Commons</p>
    </div>
  </section>
</article>

{% schema %}
{
  "name": "The Cellar Club-pagina",
  "settings": [
    { "type": "header", "content": "Kop" },
    { "type": "text", "id": "kicker", "label": "Kleine tekst boven de titel", "default": "De besloten wijnclub van Maarten" },
    { "type": "text", "id": "title", "label": "Titel", "default": "The Cellar Club" },
    { "type": "textarea", "id": "intro", "label": "Introductie", "default": "Als kok proef ik veel wijnen. De mooiste, met een verhaal, deel ik in een gratis besloten WhatsApp-club. Je kunt ze rechtstreeks bij mij bestellen, vaak in kleine oplages. Kom erbij en drink beter." },
    { "type": "text", "id": "cta_label", "label": "Knoptekst", "default": "Join The Cellar Club" },
    { "type": "text", "id": "reassure", "label": "Geruststelling onder de knop", "default": "Gratis lid. Geen verplichting om te kopen. Uitschrijven wanneer je wilt." },
    { "type": "image_picker", "id": "image", "label": "Hoofdfoto" },
    { "type": "header", "content": "Wat je krijgt" },
    { "type": "text", "id": "benefits_title", "label": "Kop", "default": "Wat je krijgt" },
    { "type": "header", "content": "Zo werkt het" },
    { "type": "text", "id": "steps_title", "label": "Kop", "default": "Zo werkt het" },
    { "type": "text", "id": "step1", "label": "Stap 1", "default": "Join gratis via WhatsApp" },
    { "type": "text", "id": "step2", "label": "Stap 2", "default": "Maarten deelt zijn wijnvondsten met foto, verhaal en prijs" },
    { "type": "text", "id": "step3", "label": "Stap 3", "default": "Bevalt een fles? Bestel hem rechtstreeks bij Maarten" },
    { "type": "header", "content": "Veelgestelde vragen" },
    { "type": "text", "id": "faq_title", "label": "Kop", "default": "Veelgestelde vragen" },
    { "type": "header", "content": "Afsluitende CTA" },
    { "type": "text", "id": "final_title", "label": "Kop", "default": "Klaar om beter te drinken?" },
    { "type": "textarea", "id": "final_text", "label": "Tekst", "default": "Join The Cellar Club en ontvang de eerstvolgende wijnvondst van Maarten." }
  ],
  "blocks": [
    { "type": "benefit", "name": "Voordeel", "settings": [
      { "type": "text", "id": "icon", "label": "Icoon (Phosphor-naam)", "default": "ph-wine" },
      { "type": "text", "id": "title", "label": "Titel" },
      { "type": "textarea", "id": "text", "label": "Tekst" }
    ]},
    { "type": "faq", "name": "Vraag", "settings": [
      { "type": "text", "id": "q", "label": "Vraag" },
      { "type": "textarea", "id": "a", "label": "Antwoord" }
    ]}
  ],
  "max_blocks": 12,
  "presets": [{ "name": "The Cellar Club-pagina" }]
}
{% endschema %}
