<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#170a0c">
    <title>
      {%- comment -%}
        Achternaam bewust in de titel: er zijn meer kooksites met een Maarten
        (kokenmetmaarten.nl, maartenkookt.blogspot.com) en dit domein was zelf
        jaren een maaltijdservice van een andere Maarten. "Maarten Kievit" is
        het enige woord dat ons daarvan onderscheidt in de zoekresultaten.
      {%- endcomment -%}
      {%- if template.name == 'index' and page_title == shop.name -%}
        Maarten Kookt &ndash; recepten en wijntips van Maarten Kievit
      {%- else -%}
        {{ page_title }}{% if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} &ndash; Pagina {{ current_page }}{% endif %}{% unless page_title contains shop.name or page_title contains 'Maarten' %} | Maarten kookt{% endunless %}
      {%- endif -%}
    </title>
    {% render 'seo-head' %}
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="icon" href="{{ 'mk-icoon-bordeaux.svg' | asset_url }}" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lilita+One&family=Montserrat:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css">
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-{{ template.name | handle }}">
    {% if template.name == 'index' %}
    <div class="intro" aria-hidden="true"><img class="intro-logo" src="{{ 'mk-icoon-bordeaux.svg' | asset_url }}" alt="" width="120" height="120"></div>
    <script>try{if(sessionStorage.getItem('mkIntro')){document.currentScript.previousElementSibling.classList.add('intro--skip');}else{sessionStorage.setItem('mkIntro','1');}}catch(e){}</script>
    {% endif %}
    <div class="grain" aria-hidden="true"></div>
    {% section 'site-header' %}
    <main id="MainContent" role="main" tabindex="-1">{{ content_for_layout }}</main>
    {% section 'site-footer' %}
    {% if template.name == 'index' %}{% render 'cellar-popup' %}{% endif %}
    <script src="{{ 'lenis.min.js' | asset_url }}" defer></script>
    <script src="{{ 'gsap.min.js' | asset_url }}" defer></script>
    <script src="{{ 'ScrollTrigger.min.js' | asset_url }}" defer></script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
