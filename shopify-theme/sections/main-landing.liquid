{% comment %}
  Home-hero. babi.sh-minimalisme: één grote titel, één duidelijke actie, weinig tekst.
  Hoofddoel = The Cellar Club (WhatsApp-wijnclub; community_url in Thema-instellingen).
{% endcomment %}
{% liquid
  assign recipes_url = pages['recepten'].url | default: '/pages/recepten'
  assign community_url = pages['join'].url | default: settings.community_url | default: recipes_url
%}
<section class="hero">
  <div class="hero-media">
    {% if section.settings.hero_image %}
      <img src="{{ section.settings.hero_image | image_url: width: 2400 }}"
           srcset="{{ section.settings.hero_image | image_url: width: 1200 }} 1200w,
                   {{ section.settings.hero_image | image_url: width: 2400 }} 2400w"
           sizes="100vw"
           alt="{{ section.settings.hero_image.alt | default: 'Maarten kookt' | escape }}"
           fetchpriority="high" width="2400" height="1350">
    {% else %}
      <img src="{{ 'hero.jpg' | asset_url }}" alt="Romige tom yum met kokkels bij kaarslicht" fetchpriority="high" width="2400" height="1350">
    {% endif %}
  </div>
  <div class="hero-content">
    <h1 class="display">
      <span class="line"><span>Maarten</span></span>
      <span class="line"><span class="lockup-sub">Kookt</span></span>
    </h1>
    {% if section.settings.subtekst != blank %}<p class="lead hero-sub">{{ section.settings.subtekst }}</p>{% endif %}
    <div class="hero-cta">
      {% if settings.community_url != blank %}
        <a class="btn btn-primary" href="{{ community_url }}" target="_blank" rel="noopener"><i class="ph ph-whatsapp-logo" aria-hidden="true"></i>{{ section.settings.cta_primary_label }}</a>
      {% endif %}
      <a class="btn btn-glass" href="{{ recipes_url }}">{{ section.settings.cta_secondary_label }}<i class="ph ph-arrow-right" aria-hidden="true"></i></a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home-hero",
  "settings": [
    { "type": "header", "content": "Achtergrondfoto" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero-foto (grote achtergrond)", "info": "Laat leeg voor de standaardfoto." },
    { "type": "header", "content": "Hero" },
    { "type": "textarea", "id": "subtekst", "label": "Eén korte regel (mag leeg)", "default": "Elke week een nieuw recept, met de wijn die erbij past." },
    { "type": "text", "id": "cta_primary_label", "label": "Bordeaux knop (The Cellar Club)", "default": "Join The Cellar Club" },
    { "type": "text", "id": "cta_secondary_label", "label": "Tweede knop", "default": "Bekijk de recepten" }
  ],
  "presets": [{ "name": "Home-hero" }]
}
{% endschema %}
