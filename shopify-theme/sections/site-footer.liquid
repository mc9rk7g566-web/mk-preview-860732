{% liquid
  assign cookbook = settings.cookbook_product
  assign cookbook_url = routes.all_products_collection_url
  if cookbook != blank
    assign cookbook_url = cookbook.url
  endif
  if settings.community_url != blank
    assign community_url = settings.community_url
  else
    assign community_url = routes.root_url | append: '#community'
  endif
%}
<footer class="footer">
  <div class="footer-inner">
    <span class="m-icon" aria-hidden="true">M</span>
    <a class="wordmark" href="{{ routes.root_url }}"><span class="wm-name">Maarten</span><span class="wm-sub">In de keuken</span></a>
    <ul class="footer-links">
      <li><a href="/pages/recepten">recepten</a></li>
      <li><a href="{{ routes.root_url }}#tips">tips &amp; technieken</a></li>
      <li><a href="{{ routes.root_url }}#over">over maarten</a></li>
      <li><a href="{{ cookbook_url }}">kookboek</a></li>
      <li><a href="{{ community_url }}" rel="noopener">de groepsapp</a></li>
      <li><a href="mailto:{{ settings.contact_email }}">contact</a></li>
    </ul>
    <div class="socials">
      {% if settings.instagram_url != blank %}<a href="{{ settings.instagram_url }}" aria-label="Instagram" rel="noopener"><i class="ph ph-instagram-logo" aria-hidden="true"></i></a>{% endif %}
      {% if settings.youtube_url != blank %}<a href="{{ settings.youtube_url }}" aria-label="YouTube" rel="noopener"><i class="ph ph-youtube-logo" aria-hidden="true"></i></a>{% endif %}
      {% if settings.tiktok_url != blank %}<a href="{{ settings.tiktok_url }}" aria-label="TikTok" rel="noopener"><i class="ph ph-tiktok-logo" aria-hidden="true"></i></a>{% endif %}
    </div>
    <p class="footer-note">Binnenkort: het eerste kookboek. De groepsapp weet het eerst.</p>
    <div class="footer-bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} Maarten, in de keuken</span>
      <span class="tagline">Passie. Smaak. Vakmanschap.</span>
      <span>Concept door JS - Crest</span>
    </div>
  </div>
</footer>

{% schema %}
{ "name": "Footer", "settings": [] }
{% endschema %}
