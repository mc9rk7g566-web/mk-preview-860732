{% comment %}
  Uitgelicht recept op de homepage. Opzet (feedback Maarten): één media + een
  scrollbaar recept-vak ernaast, zodat je het recept al op de home kunt lezen.
  De aparte receptpagina (/pages/...) blijft de SEO-bron met Recipe-structured-data.
  Ingrediënten/bereiding + media aanpasbaar via Customize.
{% endcomment %}
{% assign recipe_url = section.settings.recipe_url | default: '/pages/recepten' %}
<article id="recept" class="recipe-feature">
  <section class="recipe-hero">
    <div class="wrap">
      <p class="meta recipe-kicker reveal">{{ section.settings.kicker }}</p>
      <h2 class="display recipe-title reveal">{{ section.settings.title }}</h2>
      <p class="lead recipe-intro reveal">{{ section.settings.intro }}</p>
      <p class="meta recipe-meta reveal"><span><i class="ph ph-clock" aria-hidden="true"></i>{{ section.settings.time }}</span><span><i class="ph ph-users" aria-hidden="true"></i>{{ section.settings.servings }}</span><span><i class="ph ph-fork-knife" aria-hidden="true"></i>{{ section.settings.course }}</span></p>

      {%- assign ing_lines = section.settings.ingredients | strip | newline_to_br | split: '<br />' -%}
      {%- assign step_lines = section.settings.steps | strip | newline_to_br | split: '<br />' -%}
      <div class="recipe-feature-card reveal">
        <figure class="recipe-card-media">
          {% if section.settings.photo_1 != blank %}
            {% render 'responsive-image', image: section.settings.photo_1, fallback: 'recept-tomyum-bord.jpg', alt: section.settings.title, sizes: '(max-width: 767px) 100vw, 48vw', loading: 'lazy' %}
          {% else %}
            <video src="{{ section.settings.video_file | asset_url }}" poster="{{ section.settings.poster_file | asset_url }}" controls playsinline preload="metadata" width="464" height="832" aria-label="Kookvideo: {{ section.settings.title | escape }}"></video>
            {% if section.settings.video_note != blank %}<figcaption><i class="ph ph-video-camera" aria-hidden="true"></i>{{ section.settings.video_note }}</figcaption>{% endif %}
          {% endif %}
        </figure>
        <div class="recipe-card-scroll" tabindex="0" aria-label="Recept">
          {%- if section.settings.ingredients != blank -%}
          <h3 class="rc-head">Ingrediënten</h3>
          <ul class="rc-ingredients">
            {%- for line in ing_lines -%}{%- assign l = line | strip -%}{%- if l != blank -%}
            {%- assign parts = l | split: '—' -%}
            {%- if parts.size > 1 -%}<li><span class="rc-name">{{ parts[0] | strip }}</span><span class="rc-amt">{{ parts[1] | strip }}</span></li>
            {%- else -%}<li class="ing-group">{{ l }}</li>{%- endif -%}
            {%- endif -%}{%- endfor -%}
          </ul>
          {%- endif -%}
          {%- if section.settings.steps != blank -%}
          <h3 class="rc-head">Bereiding</h3>
          <ol class="rc-steps">
            {%- for line in step_lines -%}{%- assign l = line | strip -%}{%- if l != blank -%}<li>{{ l }}</li>{%- endif -%}{%- endfor -%}
          </ol>
          {%- endif -%}
        </div>
      </div>

      <div class="feature-cta reveal">
        <a class="btn btn-primary" href="{{ recipe_url }}">Bekijk het volledige recept<i class="ph ph-arrow-right" aria-hidden="true"></i></a>
      </div>
    </div>
  </section>

  <section class="section" id="over">
    <div class="wrap about">
      <div class="about-media reveal">
        {% render 'responsive-image', image: section.settings.about_image, fallback: 'maarten-portret.jpg', alt: 'Maarten in de keuken met het afgemaakte gerecht', sizes: '(max-width: 860px) 100vw, 42vw', loading: 'lazy' %}
      </div>
      <div class="about-body reveal">
        <h2 class="display">{{ section.settings.about_title }}</h2>
        <p>{{ section.settings.about_text_1 }}</p>
        {% if section.settings.about_text_2 != blank %}<p>{{ section.settings.about_text_2 }}</p>{% endif %}
        {% if settings.instagram_url != blank %}<a class="btn btn-glass" href="{{ settings.instagram_url }}" target="_blank" rel="noopener"><i class="ph ph-instagram-logo" aria-hidden="true"></i>Volg Maarten op Instagram</a>{% endif %}
      </div>
    </div>
  </section>
</article>

{% schema %}
{
  "name": "Uitgelicht recept",
  "settings": [
    { "type": "header", "content": "Kop" },
    { "type": "text", "id": "kicker", "label": "Kleine tekst boven de titel", "default": "Recept Nº 1" },
    { "type": "text", "id": "title", "label": "Naam van het gerecht", "default": "Romige tom yum met kokkels" },
    { "type": "textarea", "id": "intro", "label": "Introductie", "default": "Een Thaise klassieker met een romige twist van kokosmelk. Verse kokkels en hun kookvocht geven de soep zilte diepgang, limoen en koriander maken hem fris." },
    { "type": "text", "id": "time", "label": "Bereidingstijd", "default": "30 min" },
    { "type": "text", "id": "servings", "label": "Aantal personen", "default": "4 personen" },
    { "type": "text", "id": "course", "label": "Soort gerecht", "default": "Vis" },
    { "type": "text", "id": "recipe_url", "label": "Link naar het volledige recept", "info": "De receptpagina, bijv. /pages/romige-tom-yum-met-kokkels" },
    { "type": "header", "content": "Media" },
    { "type": "text", "id": "video_note", "label": "Bijschrift bij de video", "default": "Kijk mee hoe Maarten hem maakt" },
    { "type": "text", "id": "video_file", "label": "Videobestand", "info": "Het bestand in het thema, bijv. recept-tomyum-video.mp4.", "default": "recept-tomyum-video.mp4" },
    { "type": "text", "id": "poster_file", "label": "Videostill (poster)", "default": "recept-tomyum-poster.jpg" },
    { "type": "image_picker", "id": "photo_1", "label": "Eén foto i.p.v. de video (optioneel)", "info": "Zet hier één eigen foto neer om de kookvideo te vervangen. Leeg = de video blijft staan." },
    { "type": "header", "content": "Recept (scrollbaar op de home)" },
    { "type": "textarea", "id": "ingredients", "label": "Ingrediënten — één per regel, formaat: naam — hoeveelheid", "info": "Een regel zonder — wordt een tussenkop, handig bij een recept met meerdere onderdelen.", "default": "Tom yum pasta — 30 g\nKokosmelk — 500 ml\nRode chilipeper, fijngehakt — 1\nSjalotten, fijngesnipperd — 2\nKnoflook, fijngehakt — 1 teen\nVerse gember, geraspt — 50 g\nCitroengras, fijngesneden — 50 g\nVerse kokkels, schoongespoeld — 1 kg\nDroge witte wijn — 100 ml\nKookvocht van de kokkels — 2-4 el\nVissaus — 1 el\nLimoen, het sap — 1\nVerse koriander — royaal" },
    { "type": "textarea", "id": "steps", "label": "Bereiding — één stap per regel", "default": "Verhit een pan en fruit een van de gesnipperde sjalotten kort aan. Blus af met de witte wijn en breng aan de kook. Voeg de kokkels toe, doe de deksel erop en kook 3 tot 4 minuten, tot alle schelpen open staan.\nZeef het kookvocht door een fijne zeef en bewaar het. Haal de kokkels uit de schelpen en houd een paar kokkels in de schelp apart voor de presentatie.\nFruit de andere sjalot zachtjes aan met de knoflook, de gember, het citroengras en de rode chili. Voeg de tom yum pasta toe en bak die ongeveer een minuut mee, zodat de aroma's goed vrijkomen.\nSchenk de kokosmelk erbij en laat de soep vijf minuten zachtjes trekken.\nBreng de soep op smaak met het kookvocht van de kokkels, de vissaus en het limoensap. Proef tussendoor en voeg zoveel kookvocht toe als nodig is voor een mooie zilte umami-smaak.\nVoeg de kokkels toe en verwarm ze nog kort mee. Verdeel de kokkels over warme diepe borden, schenk de romige tom yum erover en garneer royaal met verse koriander. Direct serveren." },
    { "type": "header", "content": "Over Maarten" },
    { "type": "image_picker", "id": "about_image", "label": "Foto", "info": "Laat leeg voor de still uit de kookvideo." },
    { "type": "text", "id": "about_title", "label": "Titel", "default": "Over Maarten" },
    { "type": "textarea", "id": "about_text_1", "label": "Tekst 1", "default": "Ik ben Maarten. Koken is waar ik blij van word: pure smaken, gerechten met lef en altijd een goede wijn erbij. Elke week deel ik een nieuw recept dat ik zelf maak, precies zoals ik het thuis op tafel zet." },
    { "type": "textarea", "id": "about_text_2", "label": "Tekst 2", "default": "Geen sterrenkeuken-taal. Wel de kleine dingen die het verschil maken tussen goed en onvergetelijk." }
  ],
  "presets": [{ "name": "Uitgelicht recept" }]
}
{% endschema %}
