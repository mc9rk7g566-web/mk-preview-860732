{% assign recipes_url = pages['recepten'].url | default: '/pages/recepten' %}
{% if settings.community_url != blank %}{% assign community_url = settings.community_url %}{% else %}{% assign community_url = routes.root_url | append: '#community' %}{% endif %}
<article>
  <section class="recipe-hero">
    <div class="wrap">
      <a class="back" href="{{ recipes_url }}"><i class="ph ph-arrow-left" aria-hidden="true"></i>Alle recepten</a>
      <h1 class="display recipe-title">{{ section.settings.title }}</h1>
      <p class="meta"><span><i class="ph ph-clock" aria-hidden="true"></i>{{ section.settings.time }}</span><span><i class="ph ph-users" aria-hidden="true"></i>{{ section.settings.servings }}</span><span><i class="ph ph-fork-knife" aria-hidden="true"></i>{{ section.settings.course }}</span></p>
      <div class="recipe-media reveal">
        {% render 'responsive-image', image: section.settings.hero_image, fallback: 'recept-vis.jpg', alt: section.settings.title, sizes: 'calc(100vw - 48px)', fetchpriority: 'high' %}
        {% if section.settings.video_note != blank %}<span class="video-note"><i class="ph ph-video-camera" aria-hidden="true"></i>{{ section.settings.video_note }}</span>{% endif %}
      </div>
    </div>
  </section>
  <section class="wrap recipe-body">
    <aside class="ingredients reveal"><h2>Ingrediënten</h2><ul>
      {% for block in section.blocks %}{% if block.type == 'ingredient' %}<li {{ block.shopify_attributes }}><strong>{{ block.settings.name }}</strong><span>{{ block.settings.amount }}</span></li>{% endif %}{% endfor %}
    </ul></aside>
    <div class="method reveal"><h2>Bereiding</h2><ol>
      {% for block in section.blocks %}{% if block.type == 'step' %}<li {{ block.shopify_attributes }}><p>{{ block.settings.text }}</p></li>{% endif %}{% endfor %}
    </ol></div>
  </section>
  <section class="wrap recipe-wine-section">
    <div class="wine-tip reveal">
      <div class="wt-media">{% render 'responsive-image', image: section.settings.wine_image, fallback: 'wijn-donker.jpg', alt: 'Wijn wordt ingeschonken', sizes: '(max-width: 767px) 100vw, 42vw', loading: 'lazy' %}</div>
      <div class="wt-body"><span class="wt-label"><i class="ph ph-wine" aria-hidden="true"></i>De wijntip van Maarten</span><h2>{{ section.settings.wine_title }}</h2><p>{{ section.settings.wine_text }}</p><a class="btn btn-light" href="{{ community_url }}" rel="noopener"><i class="ph ph-whatsapp-logo" aria-hidden="true"></i>Proef mee</a></div>
    </div>
  </section>
  <section class="section section-band">
    <div class="wrap"><div class="section-head reveal"><h2 class="display related-title">Ook lekker</h2><a class="link-more" href="{{ recipes_url }}">Alle recepten<i class="ph ph-arrow-right" aria-hidden="true"></i></a></div>
      <div class="recipe-grid">
        <a class="recipe-card reveal" href="{{ recipes_url }}"><div class="thumb"><img src="{{ 'recept-pasta.jpg' | asset_url }}" width="1200" height="800" alt="Pasta met gamba's" loading="lazy"></div><h3>Pasta met gamba's</h3><p class="meta">25 min · Vis</p></a>
        <a class="recipe-card reveal" href="{{ recipes_url }}"><div class="thumb"><img src="{{ 'recept-soep.jpg' | asset_url }}" width="1200" height="1500" alt="Pompoensoep met salie" loading="lazy"></div><h3>Pompoensoep met salie</h3><p class="meta">40 min · Warm voorgerecht</p></a>
        <a class="recipe-card reveal" href="{{ recipes_url }}"><div class="thumb"><img src="{{ 'recept-steak.jpg' | asset_url }}" width="1200" height="800" alt="Ribeye van de plaat" loading="lazy"></div><h3>Ribeye van de plaat</h3><p class="meta">35 min · Vlees</p></a>
      </div>
    </div>
  </section>
</article>

{% schema %}
{
  "name": "Recept",
  "settings": [
    { "type": "text", "id": "title", "label": "Titel", "default": "Zalm met beurre blanc" },
    { "type": "text", "id": "time", "label": "Bereidingstijd", "default": "30 min" },
    { "type": "text", "id": "servings", "label": "Aantal personen", "default": "4 personen" },
    { "type": "text", "id": "course", "label": "Gang", "default": "Hoofdgerecht" },
    { "type": "image_picker", "id": "hero_image", "label": "Gerechtfoto" },
    { "type": "text", "id": "video_note", "label": "Videomelding", "default": "Kookvideo volgt bij lancering" },
    { "type": "image_picker", "id": "wine_image", "label": "Wijnafbeelding" },
    { "type": "text", "id": "wine_title", "label": "Wijntitel", "default": "Een strakke witte bourgogne" },
    { "type": "textarea", "id": "wine_text", "label": "Wijntip", "default": "Beurre blanc vraagt om frisheid met een beetje vet. Een chardonnay zonder zware houtlagering snijdt door de botersaus heen en tilt de zalm op. Welke fles ik nu op tafel zet, deel ik in de groepsapp." }
  ],
  "blocks": [
    { "type": "ingredient", "name": "Ingrediënt", "settings": [{ "type": "text", "id": "name", "label": "Naam" }, { "type": "text", "id": "amount", "label": "Hoeveelheid" }] },
    { "type": "step", "name": "Bereidingsstap", "settings": [{ "type": "textarea", "id": "text", "label": "Uitleg" }] }
  ],
  "max_blocks": 30,
  "presets": [{ "name": "Recept" }]
}
{% endschema %}
