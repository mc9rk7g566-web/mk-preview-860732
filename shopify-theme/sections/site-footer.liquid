<footer class="footer">
  <div class="footer-inner">
    <img class="m-icon" src="{{ 'mk-icoon-bordeaux.svg' | asset_url }}" alt="Maarten kookt" width="64" height="64">
    <a class="wordmark" href="{{ routes.root_url }}"><span class="wm-name">Maarten</span><span class="wm-sub">Kookt</span></a>
    {% unless settings.landing_mode %}
    <ul class="footer-links">
      <li><a href="{{ pages['recepten'].url | default: '/pages/recepten' }}">recepten</a></li>
      <li><a href="{{ routes.root_url }}#over">over maarten</a></li>
      {% if pages['the-cellar-club'] != blank %}<li><a href="{{ pages['the-cellar-club'].url }}">the cellar club</a></li>{% elsif settings.community_url != blank %}<li><a href="{{ pages['join'].url | default: settings.community_url }}" target="_blank" rel="noopener">the cellar club</a></li>{% endif %}
      <li><a href="mailto:{{ settings.contact_email }}">contact</a></li>
    </ul>
    {% endunless %}
    {% if settings.instagram_url != blank %}
    <div class="socials">
      <a href="{{ settings.instagram_url }}" target="_blank" aria-label="Instagram" rel="noopener"><i class="ph ph-instagram-logo" aria-hidden="true"></i></a>
    </div>
    {% endif %}
    <p class="footer-note"><a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a></p>

    {%- comment -%} Juridische links — verschijnen zodra Maarten de pagina's heeft aangemaakt {%- endcomment -%}
    {%- if pages['privacyverklaring'] != blank or pages['cookiebeleid'] != blank or pages['algemene-voorwaarden'] != blank -%}
    <ul class="footer-legal">
      {% if pages['privacyverklaring'] != blank %}<li><a href="{{ pages['privacyverklaring'].url }}">Privacyverklaring</a></li>{% endif %}
      {% if pages['cookiebeleid'] != blank %}<li><a href="{{ pages['cookiebeleid'].url }}">Cookiebeleid</a></li>{% endif %}
      {% if pages['algemene-voorwaarden'] != blank %}<li><a href="{{ pages['algemene-voorwaarden'].url }}">Algemene voorwaarden</a></li>{% endif %}
    </ul>
    {%- endif -%}

    {%- if settings.legal_name != blank -%}
    <p class="footer-legal-info">{{ settings.legal_name }}{% if settings.kvk != blank %} &middot; KvK {{ settings.kvk }}{% endif %}{% if settings.btw != blank %} &middot; btw {{ settings.btw }}{% endif %}{% if settings.address != blank %} &middot; {{ settings.address }}{% endif %} &middot; Wijn: uitsluitend verkoop 18+</p>
    {%- endif -%}

    <div class="footer-bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} Maarten kookt</span>
      <span class="tagline">Passie. Smaak. Vakmanschap.</span>
    </div>
  </div>
</footer>

{% schema %}
{ "name": "Footer", "settings": [] }
{% endschema %}
