{% comment %}
  The Cellar Club: de besloten WhatsApp-wijnclub van Maarten (exclusieve wijnen kopen).
  Conversiegericht: waardepropositie + 'zo werkt het' (3 stappen) + geruststelling.
  Link = community_url in Thema-instellingen. Optionele 'meer weten'-link = settings.more_url.
{% endcomment %}
{% assign community_url = pages['join'].url | default: settings.community_url | default: '#' %}
<section class="section community">
  <div class="wrap">
    <div class="community-card reveal">
      <div class="community-media">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1400 | image_tag: widths: '560, 840, 1120, 1400', sizes: '(max-width: 900px) 100vw, 46vw', loading: 'lazy', alt: 'The Cellar Club — exclusieve wijn van Maarten' }}
        {% else %}
          <img src="{{ 'cellar-club.jpg' | asset_url }}" width="1800" height="1200" alt="Een glas rode wijn in warm, filmisch licht" loading="lazy">
        {% endif %}
      </div>
      <div class="community-body">
        <span class="wt-label">{{ section.settings.label }}</span>
        <h2 class="display">{{ section.settings.heading }}</h2>
        <p>{{ section.settings.text }}</p>
        <ol class="community-steps">
          {% if section.settings.step1 != blank %}<li>{{ section.settings.step1 }}</li>{% endif %}
          {% if section.settings.step2 != blank %}<li>{{ section.settings.step2 }}</li>{% endif %}
          {% if section.settings.step3 != blank %}<li>{{ section.settings.step3 }}</li>{% endif %}
        </ol>
        {% if settings.community_url != blank %}
          <div class="community-cta-row">
            <a class="btn btn-light community-cta" href="{{ community_url }}" target="_blank" rel="noopener"><i class="ph ph-whatsapp-logo" aria-hidden="true"></i>{{ section.settings.button_label }}</a>
            {% if section.settings.more_url != blank and section.settings.more_label != blank %}
              <a class="btn btn-outline-light" href="{{ section.settings.more_url }}">{{ section.settings.more_label }}</a>
            {% endif %}
          </div>
          {% if section.settings.note != blank %}<p class="community-note">{{ section.settings.note }}</p>{% endif %}
        {% else %}
          <p class="community-note">Zet de The Cellar Club-link in de thema-instellingen om deze knop te activeren.</p>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "The Cellar Club",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Foto", "info": "Laat leeg voor de standaardfoto." },
    { "type": "text", "id": "label", "label": "Klein label", "default": "De wijnclub van Maarten" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Join The Cellar Club" },
    { "type": "textarea", "id": "text", "label": "Tekst", "default": "Een gratis, besloten WhatsApp-club voor wijnliefhebbers. Maarten kiest exclusieve flessen uit die je rechtstreeks kunt bestellen: vaak in kleine oplages en altijd met een verhaal." },
    { "type": "header", "content": "Zo werkt het (3 stappen)" },
    { "type": "text", "id": "step1", "label": "Stap 1", "default": "Join gratis via WhatsApp" },
    { "type": "text", "id": "step2", "label": "Stap 2", "default": "Maarten deelt zijn wijnvondsten" },
    { "type": "text", "id": "step3", "label": "Stap 3", "default": "Bestel wat je aanspreekt" },
    { "type": "header", "content": "Knoppen" },
    { "type": "text", "id": "button_label", "label": "Hoofdknop", "default": "Join The Cellar Club" },
    { "type": "text", "id": "note", "label": "Tekst onder de knop", "default": "Gratis lid. Geen verplichting om te kopen." },
    { "type": "text", "id": "more_url", "label": "Link 'meer weten' (leeg = geen knop)", "info": "Bijv. /pages/the-cellar-club" },
    { "type": "text", "id": "more_label", "label": "Tekst tweede knop", "default": "Zo werkt het" }
  ],
  "presets": [{ "name": "The Cellar Club" }]
}
{% endschema %}
