{% liquid
  assign recipes_url = pages['recepten'].url | default: '/pages/recepten'
  comment
    Bestaat de over-pagina, dan linkt 'over' daarheen in plaats van naar het
    anker op de homepage. Een eigen pagina kan Google indexeren, een anker niet.
    Valt terug op het anker zolang de pagina er niet is.
  endcomment
  assign over_url = pages['over-maarten'].url | default: '/#over'
  assign cellar_page = pages['the-cellar-club']
  if cellar_page != blank
    assign cta_url = cellar_page.url
    assign cta_label = 'The Cellar Club'
    assign cta_icon = ''
    assign cta_blank = false
  elsif settings.community_url != blank
    assign cta_url = pages['join'].url | default: settings.community_url
    assign cta_label = 'The Cellar Club'
    assign cta_icon = ''
    assign cta_blank = true
  else
    assign cta_url = routes.root_url | append: '#recept'
    assign cta_label = 'Bekijk het recept'
    assign cta_icon = 'ph-arrow-right'
    assign cta_blank = false
  endif
%}
<a class="skip-link" href="#MainContent">Ga naar inhoud</a>
<header class="nav{% unless template.name == 'index' %} is-solid{% endunless %}">
  <div class="nav-inner">
    <a class="wordmark" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
      <span class="wm-name">Maarten</span><span class="wm-sub">Kookt</span>
    </a>
    {% unless settings.landing_mode %}
    <ul class="nav-links">
      <li><a href="{{ recipes_url }}"{% if page.handle == 'recepten' or template.name == 'page' and page.templates contains 'recept' %} aria-current="page"{% endif %}>recepten</a></li>
      <li><a href="{{ over_url }}"{% if page.handle == 'over-maarten' %} aria-current="page"{% endif %}>over</a></li>
      <li><a class="btn btn-primary" href="{{ cta_url }}"{% if cta_blank %} target="_blank" rel="noopener"{% endif %}>{% if cta_icon != blank %}<i class="ph {{ cta_icon }}" aria-hidden="true"></i>{% endif %}{{ cta_label }}</a></li>
    </ul>
    <button class="nav-toggle" aria-expanded="false" aria-controls="MobileMenu" aria-label="Menu openen"><span></span><span></span></button>
    {% endunless %}
  </div>
</header>
{% unless settings.landing_mode %}
<nav class="menu-overlay" id="MobileMenu" aria-label="Menu">
  <a href="{{ routes.root_url }}"{% if template.name == 'index' %} aria-current="page"{% endif %}>home</a>
  <a href="{{ recipes_url }}"{% if page.handle == 'recepten' %} aria-current="page"{% endif %}>recepten</a>
  <a href="{{ over_url }}"{% if page.handle == 'over-maarten' %} aria-current="page"{% endif %}>over</a>
  <a class="btn" href="{{ cta_url }}"{% if cta_blank %} target="_blank" rel="noopener"{% endif %}>{% if cta_icon != blank %}<i class="ph {{ cta_icon }}" aria-hidden="true"></i>{% endif %}{{ cta_label }}</a>
  <span class="menu-tagline">Passie. Smaak. Vakmanschap.</span>
</nav>
{% endunless %}

{% schema %}
{ "name": "Header", "settings": [] }
{% endschema %}
