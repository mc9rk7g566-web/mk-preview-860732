<section class="hero">
  <div class="hero-media">
    <img src="{{ 'hero.jpg' | asset_url }}" alt="Donker gedekte tafel met borden bij kaarslicht" width="2400" height="1600">
  </div>
  <div class="hero-content">
    <h1 class="display">
      <span class="line"><span>Maarten</span></span>
      <span class="line"><span class="lockup-sub">In de keuken</span></span>
    </h1>
    <p class="lead hero-sub">Er wordt gekookt. De site opent binnenkort.</p>
    {% form 'storefront_password', class: 'signup-form' %}
      <input type="password" name="password" placeholder="wachtwoord" aria-label="Wachtwoord" required>
      <button type="submit" class="btn btn-primary">Binnen kijken</button>
      {% if form.errors %}<p class="form-error">Dat wachtwoord klopt niet.</p>{% endif %}
    {% endform %}
  </div>
</section>
